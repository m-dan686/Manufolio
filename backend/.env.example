# Manufolio Backend Environment Variables Template
# Copy or set these environment variables on your production hosting server (e.g., Render / Railway / AWS).

DB_URL=jdbc:mysql://localhost:3306/manufolio_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root
JWT_SECRET=manufolio-super-secret-key-2026-spring-boot-jwt-authentication-key
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
ADMIN_SEED_USERNAME=manu
ADMIN_SEED_PASSWORD=manu@123

# Mail / Gmail SMTP Credentials
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
MAIL_TO=your_gmail_address@gmail.com

